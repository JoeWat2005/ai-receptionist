OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Set to clerk to enforce Clerk authentication in app.
AUTH_PROVIDER=none

# Clerk verification config (choose one key strategy):
# 1) JWKS URL (recommended)
CLERK_JWKS_URL=
# 2) Or static public key PEM
CLERK_JWT_PUBLIC_KEY=

# Optional token validation constraints
CLERK_ISSUER=
CLERK_AUDIENCE=

# Admin authorization
CLERK_ADMIN_ROLE_VALUE=admin
CLERK_ADMIN_EMAILS=
