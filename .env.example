OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Clerk auth mode: "clerk" or "none" (local demo).
AUTH_PROVIDER=clerk

# Admin authorization
CLERK_ADMIN_ROLE_VALUE=admin
CLERK_ADMIN_EMAILS=watmoughjoe2005@gmail.com

# Clerk OIDC settings (all from Clerk dashboard)
# Publishable key (or set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY instead)
CLERK_CLIENT_ID=pk_test_xxxxxxxxxxxxxxxxxxxxx
# Secret key (or set CLERK_SECRET_KEY instead)
CLERK_CLIENT_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Option A: full metadata URL
CLERK_SERVER_METADATA_URL=https://your-clerk-domain/.well-known/openid-configuration
# Option B: frontend API URL (app will derive metadata URL).
# If you use this, leave CLERK_SERVER_METADATA_URL empty.
CLERK_FRONTEND_API_URL=

# Streamlit auth callback + cookie secret
STREAMLIT_REDIRECT_URI=http://localhost:8501/oauth2callback
STREAMLIT_COOKIE_SECRET=replace_with_random_hex_string
